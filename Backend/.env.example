NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:8081
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/somos-barrio?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET="super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

AI_PROVIDER_URL="http://localhost:1234/v1"
AI_API_KEY="lm-studio"
AI_MODEL="qwen2.5-7b-instruct-1m"
AI_DAILY_USER_LIMIT=3
AI_GLOBAL_DAILY_TOKEN_BUDGET=0
AI_MAX_CONCURRENCY=10
AI_CACHE_TTL_SECONDS=86400
AI_ENABLED=true
# Presupuesto estimado de tokens de entrada, tope de salida y structured output (json_schema) del proveedor
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=6000
AI_JSON_SCHEMA_ENABLED=true
JWT_REFRESH_EXPIRES_DAYS=30
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
SIGHTENGINE_ENABLED=false
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_TIMEOUT_MS=8000
# JSON completo: cada categoría requiere 0 <= review < block <= 1
SIGHTENGINE_THRESHOLDS={"nudity":{"review":0.35,"block":0.7},"sexual":{"review":0.35,"block":0.7},"violence":{"review":0.35,"block":0.7},"gore":{"review":0.35,"block":0.7},"weapons":{"review":0.35,"block":0.7},"drugs":{"review":0.35,"block":0.7},"alcohol":{"review":0.35,"block":0.7},"tobacco":{"review":0.35,"block":0.7},"offensiveSymbols":{"review":0.35,"block":0.7}}
MARKETPLACE_ASSET_CLEANUP_INTERVAL_MS=3600000
MARKETPLACE_ASSET_ORPHAN_TTL_MS=86400000
MARKETPLACE_REPORT_THRESHOLD=3
MARKETPLACE_REPORT_WINDOW_MS=3600000
MARKETPLACE_REPORT_USER_LIMIT=10
MARKETPLACE_APPEAL_USER_LIMIT=5
MARKETPLACE_ASSET_REVIEW_URL_TTL_SECONDS=300
MARKETPLACE_ASSET_REVIEW_TTL_MS=604800000

# Foro: límites de escritura por ventana (hilos, respuestas y ediciones por usuario; total por IP)
FORUM_RATE_LIMIT_WINDOW_MS=3600000
FORUM_THREAD_USER_LIMIT=5
FORUM_REPLY_USER_LIMIT=30
FORUM_EDIT_USER_LIMIT=20
FORUM_WRITE_IP_LIMIT=150
# Reportes abiertos que ocultan preventivamente un contenido; límites de reportes y apelaciones por usuario
FORUM_REPORT_THRESHOLD=3
FORUM_REPORT_USER_LIMIT=10
FORUM_APPEAL_USER_LIMIT=5

# Optional for Expo projects with push security enabled
EXPO_ACCESS_TOKEN=
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_FETCH_TIMEOUT_MS=10000
