generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  VECINO
  NEGOCIO
  EDITOR
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

enum NewsCategory {
  SEGURIDAD
  OBRAS
  EVENTOS
  MUNICIPIO
  COMUNIDAD
}

enum NewsStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum NewsVoteValue {
  CONFIRM
  DISPUTE
  UNSURE
}

enum BusinessCategory {
  GASTRONOMIA
  SALUD
  EDUCACION
  SERVICIOS
  HOGAR
  DEPORTES
  OTROS
}

enum MarketplaceCategory {
  ELECTRONICA
  ROPA
  MUEBLES
  DEPORTES
  SE_BUSCA
  SE_REGALA
  OTROS
}

enum MarketplaceAvailability {
  AVAILABLE
  SOLD
  PAUSED
}

enum MarketplaceAssetStatus {
  QUARANTINED
  APPROVED
  REJECTED
  DELETE_PENDING
  PROMOTION_PENDING
  REJECTION_PENDING
}

enum MarketplaceModerationAction {
  AUTO_REVIEW
  REPORT_THRESHOLD
  APPROVE
  REJECT
  REMOVE
  RESTORE
  OWNER_RESUBMIT
  APPEAL_ACCEPT
  APPEAL_REJECT
}

enum MarketplaceReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum MarketplaceAppealStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum MarketplaceAssetModerationAction {
  APPROVE
  REJECT
}

enum MarketplaceReportCategory {
  FRAUD
  SPAM
  INAPPROPRIATE
  WEAPONS
  DRUGS
  OTHER
}

enum ModerationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  REMOVED
}

enum ForumContentStatus {
  PUBLISHED
  PENDING_REVIEW
  BLOCKED
  REMOVED
}

enum ForumModerationAction {
  AUTO_REVIEW
  OWNER_EDIT
  OWNER_DELETE
  REPORT_THRESHOLD
  APPROVE
  BLOCK
  REMOVE
  RESTORE
  DISMISS_REPORTS
  APPEAL_ACCEPT
  APPEAL_REJECT
}

enum ForumReportCategory {
  THREAT
  HARASSMENT
  DISCRIMINATION
  SPAM
  OTHER
}

enum ForumReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ForumAppealStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum EventRsvpStatus {
  GOING
  INTERESTED
  NOT_GOING
}

model Barrio {
  id                String                    @id @default(cuid())
  name              String
  slug              String                    @unique
  city              String
  province          String
  country           String                    @default("AR")
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  users             User[]
  businesses        Business[]
  news              News[]
  marketplacePosts  MarketplacePost[]
  marketplaceAssets MarketplaceAsset[]
  forumSubforums    ForumSubforum[]
  forumThreads      ForumThread[]
  forumDecisions    ForumModerationDecision[]
  events            Event[]
}

model User {
  id                         String                               @id @default(cuid())
  email                      String                               @unique
  name                       String
  nickname                   String?
  bio                        String?
  passwordHash               String?
  avatarUrl                  String?
  avatarPublicId             String?
  role                       UserRole                             @default(VECINO)
  authProvider               AuthProvider                         @default(LOCAL)
  authProviderAccountId      String?
  barrioId                   String?
  createdAt                  DateTime                             @default(now())
  updatedAt                  DateTime                             @updatedAt
  barrio                     Barrio?                              @relation(fields: [barrioId], references: [id], onDelete: SetNull)
  businesses                 Business[]
  news                       News[]
  marketplacePosts           MarketplacePost[]
  forumThreads               ForumThread[]
  forumReplies               ForumReply[]
  events                     Event[]
  sentMessages               Message[]                            @relation("messages_sent")
  receivedMessages           Message[]                            @relation("messages_received")
  reviews                    Review[]
  eventRsvps                 EventRsvp[]
  forumVotes                 ForumVote[]
  newsVotes                  NewsVote[]
  pushDevices                PushDevice[]
  notificationOutbox         NotificationOutbox[]
  marketplaceDecisions       MarketplaceModerationDecision[]
  marketplaceReports         MarketplaceReport[]                  @relation("MarketplaceReportReporter")
  resolvedMarketplaceReports MarketplaceReport[]                  @relation("MarketplaceReportResolver")
  marketplaceAssets          MarketplaceAsset[]
  marketplaceAppeals         MarketplaceAppeal[]                  @relation("MarketplaceAppealOwner")
  resolvedMarketplaceAppeals MarketplaceAppeal[]                  @relation("MarketplaceAppealResolver")
  assetModerationDecisions   MarketplaceAssetModerationDecision[]
  forumDecisions             ForumModerationDecision[]            @relation("ForumDecisionActor")
  forumReports               ForumReport[]                        @relation("ForumReportReporter")
  resolvedForumReports       ForumReport[]                        @relation("ForumReportResolver")
  forumAppeals               ForumAppeal[]                        @relation("ForumAppealOwner")
  resolvedForumAppeals       ForumAppeal[]                        @relation("ForumAppealResolver")

  @@index([barrioId])
  @@index([role])
}

model Business {
  id          String           @id @default(cuid())
  ownerId     String
  barrioId    String
  name        String
  slug        String           @unique
  category    BusinessCategory
  address     String
  description String?
  phone       String?
  whatsapp    String?
  website     String?
  instagram   String?
  facebook    String?
  verified    Boolean          @default(false)
  coverImage  String?
  photos      String[]
  latitude    Decimal?         @db.Decimal(10, 7)
  longitude   Decimal?         @db.Decimal(10, 7)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  barrio      Barrio           @relation(fields: [barrioId], references: [id], onDelete: Cascade)
  reviews     Review[]

  @@index([ownerId])
  @@index([barrioId, category])
}

model News {
  id                String       @id @default(cuid())
  authorId          String
  barrioId          String
  title             String
  slug              String       @unique
  excerpt           String?
  content           String
  category          NewsCategory
  status            NewsStatus   @default(DRAFT)
  editorObservation String?
  publishedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  confirmVotes Int @default(0)
  disputeVotes Int @default(0)
  unsureVotes  Int @default(0)

  aiSummary Json?

  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  barrio Barrio     @relation(fields: [barrioId], references: [id], onDelete: Cascade)
  votes  NewsVote[]

  @@index([barrioId, status])
  @@index([category, publishedAt])
}

model NewsVote {
  id        String        @id @default(cuid())
  userId    String
  newsId    String
  value     NewsVoteValue
  reason    String
  sourceUrl String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
  @@index([newsId])
}

model MarketplacePost {
  id                   String                          @id @default(cuid())
  userId               String
  barrioId             String
  title                String
  description          String
  price                Int?
  currency             String                          @default("ARS")
  category             MarketplaceCategory
  availability         MarketplaceAvailability         @default(AVAILABLE)
  moderationStatus     ModerationStatus                @default(PENDING_REVIEW)
  moderationReasonCode String?
  whatsapp             String?
  images               String[]
  legacyImages         String[]                        @default([])
  location             String?
  views                Int                             @default(0)
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  user                 User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  barrio               Barrio                          @relation(fields: [barrioId], references: [id], onDelete: Cascade)
  messages             Message[]
  decisions            MarketplaceModerationDecision[]
  reports              MarketplaceReport[]
  assets               MarketplaceAsset[]
  appeals              MarketplaceAppeal[]
  moderationVersion    Int                             @default(0)
  deletedAt            DateTime?

  @@index([userId])
  @@index([barrioId, deletedAt, moderationStatus, updatedAt])
}

model MarketplaceAsset {
  id                  String                               @id @default(cuid())
  uploaderId          String
  postId              String?
  status              MarketplaceAssetStatus               @default(QUARANTINED)
  provider            String                               @default("sightengine")
  providerRequestId   String?
  scores              Json?
  mimeType            String
  byteSize            Int
  contentHash         String
  cloudinaryPublicId  String?                              @unique
  cloudinaryType      String?
  url                 String?
  ocrDecision         String?
  ocrCategories       String[]                             @default([])
  ocrRuleId           String?
  ocrRuleVersion      String?
  ocrPolicyVersion    String?
  ocrContentHash      String?
  scannedAt           DateTime?
  deletionRequestedAt DateTime?
  deletionAttempts    Int                                  @default(0)
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt
  barrioId            String?
  moderationVersion   Int                                  @default(0)
  reviewDecisions     MarketplaceAssetModerationDecision[]
  uploader            User                                 @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  post                MarketplacePost?                     @relation(fields: [postId], references: [id], onDelete: SetNull)
  barrio              Barrio?                              @relation(fields: [barrioId], references: [id], onDelete: SetNull)

  @@index([uploaderId, createdAt])
  @@index([postId])
  @@index([postId, status])
  @@index([deletionRequestedAt])
}

model MarketplaceModerationDecision {
  id             String                       @id @default(cuid())
  postId         String
  moderatorId    String?
  status         ModerationStatus
  reason         String?
  privateNote    String?
  ruleId         String?
  ruleVersion    String?
  policyVersion  String?
  domain         String?
  severity       String?
  contentHash    String?
  categories     String[]                     @default([])
  action         MarketplaceModerationAction?
  reasonCode     String?
  fromStatus     ModerationStatus?
  fromVersion    Int?
  toVersion      Int?
  idempotencyKey String?                      @unique
  evidence       Json?
  appealId       String?
  createdAt      DateTime                     @default(now())

  post            MarketplacePost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  moderator       User?               @relation(fields: [moderatorId], references: [id], onDelete: SetNull)
  appeal          MarketplaceAppeal?  @relation("AppealOutcome", fields: [appealId], references: [id], onDelete: SetNull)
  appealsAgainst  MarketplaceAppeal[] @relation("AppealAgainstDecision")
  resolvedAppeals MarketplaceAppeal[] @relation("AppealResolutionDecision")
  resolvedReports MarketplaceReport[] @relation("ReportResolutionDecision")

  @@unique([postId, toVersion])
  @@index([postId, createdAt])
}

model MarketplaceReport {
  id                   String                    @id @default(cuid())
  postId               String
  reporterId           String
  category             MarketplaceReportCategory
  comment              String?
  status               MarketplaceReportStatus   @default(OPEN)
  resolvedAt           DateTime?
  resolvedById         String?
  resolutionDecisionId String?
  createdAt            DateTime                  @default(now())

  post               MarketplacePost                @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter           User                           @relation("MarketplaceReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy         User?                          @relation("MarketplaceReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionDecision MarketplaceModerationDecision? @relation("ReportResolutionDecision", fields: [resolutionDecisionId], references: [id], onDelete: SetNull)

  @@unique([postId, reporterId])
  @@index([postId, createdAt])
}

model MarketplaceAppeal {
  id                   String                  @id @default(cuid())
  postId               String
  ownerId              String
  againstDecisionId    String?
  statement            String
  status               MarketplaceAppealStatus @default(PENDING)
  idempotencyKey       String                  @unique
  postVersion          Int
  resolutionDecisionId String?
  resolvedById         String?
  resolvedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  post               MarketplacePost                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  owner              User                            @relation("MarketplaceAppealOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  resolvedBy         User?                           @relation("MarketplaceAppealResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  againstDecision    MarketplaceModerationDecision?  @relation("AppealAgainstDecision", fields: [againstDecisionId], references: [id], onDelete: SetNull)
  resolutionDecision MarketplaceModerationDecision?  @relation("AppealResolutionDecision", fields: [resolutionDecisionId], references: [id], onDelete: SetNull)
  outcomeDecisions   MarketplaceModerationDecision[] @relation("AppealOutcome")

  @@index([postId])
}

model MarketplaceAssetModerationDecision {
  id             String                           @id @default(cuid())
  assetId        String
  moderatorId    String?
  action         MarketplaceAssetModerationAction
  reasonCode     String?
  privateNote    String?
  fromStatus     MarketplaceAssetStatus?
  toStatus       MarketplaceAssetStatus?
  fromVersion    Int?
  toVersion      Int?
  idempotencyKey String                           @unique
  policyVersion  String?
  evidence       Json?
  createdAt      DateTime                         @default(now())

  asset     MarketplaceAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  moderator User?            @relation(fields: [moderatorId], references: [id], onDelete: SetNull)

  @@unique([assetId, toVersion])
  @@index([assetId, createdAt])
}

model ForumSubforum {
  id          String        @id @default(cuid())
  barrioId    String
  name        String
  slug        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  barrio      Barrio        @relation(fields: [barrioId], references: [id], onDelete: Cascade)
  threads     ForumThread[]

  @@unique([barrioId, slug])
}

model ForumThread {
  id                      String                    @id @default(cuid())
  userId                  String
  barrioId                String
  subforumId              String
  title                   String
  content                 String
  upVotes                 Int                       @default(0)
  downVotes               Int                       @default(0)
  isClosed                Boolean                   @default(false)
  closedAt                DateTime?
  closedById              String?
  status                  ForumContentStatus        @default(PUBLISHED)
  moderationReasonCode    String?
  moderationRuleId        String?
  moderationPolicyVersion String?
  moderationContentHash   String?
  // Versión para CAS: cada transición de moderación la incrementa.
  moderationVersion       Int                       @default(0)
  // Borrado lógico: el autor borra sin destruir la evidencia de moderación.
  deletedAt               DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  barrio                  Barrio                    @relation(fields: [barrioId], references: [id], onDelete: Cascade)
  subforum                ForumSubforum             @relation(fields: [subforumId], references: [id], onDelete: Cascade)
  replies                 ForumReply[]
  votes                   ForumVote[]
  decisions               ForumModerationDecision[]
  reports                 ForumReport[]
  appeals                 ForumAppeal[]

  @@index([subforumId, createdAt])
  @@index([barrioId, createdAt])
  @@index([subforumId, status, createdAt])
  @@index([barrioId, status, createdAt])
}

model ForumReply {
  id                      String                    @id @default(cuid())
  threadId                String
  userId                  String
  parentReplyId           String?
  content                 String
  upVotes                 Int                       @default(0)
  downVotes               Int                       @default(0)
  status                  ForumContentStatus        @default(PUBLISHED)
  moderationReasonCode    String?
  moderationRuleId        String?
  moderationPolicyVersion String?
  moderationContentHash   String?
  // Primera vez que quedó publicada; evita notificar dos veces.
  publishedAt             DateTime?
  moderationVersion       Int                       @default(0)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  thread                  ForumThread               @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentReply             ForumReply?               @relation("ReplyHierarchy", fields: [parentReplyId], references: [id], onDelete: SetNull)
  childReplies            ForumReply[]              @relation("ReplyHierarchy")
  votes                   ForumVote[]
  decisions               ForumModerationDecision[]
  reports                 ForumReport[]
  appeals                 ForumAppeal[]

  @@index([threadId, createdAt])
  @@index([threadId, status, createdAt])
  @@index([userId])
  @@index([parentReplyId])
}

// Historial append-only de transiciones de un hilo o una respuesta (exactamente uno).
model ForumModerationDecision {
  id               String                @id @default(cuid())
  threadId         String?
  replyId          String?
  barrioId         String
  actorId          String?
  action           ForumModerationAction
  fromStatus       ForumContentStatus?
  toStatus         ForumContentStatus
  fromVersion      Int?
  toVersion        Int
  reasonCode       String?
  privateNote      String?
  ruleId           String?
  // Regla automática revertida por una aprobación humana; alimenta la métrica de overrides.
  overriddenRuleId String?
  policyVersion    String?
  contentHash      String?
  categories       String[]              @default([])
  idempotencyKey   String?               @unique
  evidence         Json?
  appealId         String?
  createdAt        DateTime              @default(now())

  thread          ForumThread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply           ForumReply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  barrio          Barrio        @relation(fields: [barrioId], references: [id], onDelete: Cascade)
  actor           User?         @relation("ForumDecisionActor", fields: [actorId], references: [id], onDelete: SetNull)
  appeal          ForumAppeal?  @relation("ForumAppealOutcome", fields: [appealId], references: [id], onDelete: SetNull)
  appealsAgainst  ForumAppeal[] @relation("ForumAppealAgainstDecision")
  resolvedAppeals ForumAppeal[] @relation("ForumAppealResolutionDecision")
  resolvedReports ForumReport[] @relation("ForumReportResolutionDecision")

  @@unique([threadId, toVersion])
  @@unique([replyId, toVersion])
  @@index([barrioId, createdAt])
  @@index([overriddenRuleId])
}

model ForumReport {
  id                   String              @id @default(cuid())
  threadId             String?
  replyId              String?
  reporterId           String
  category             ForumReportCategory
  comment              String?
  status               ForumReportStatus   @default(OPEN)
  resolvedAt           DateTime?
  resolvedById         String?
  resolutionDecisionId String?
  createdAt            DateTime            @default(now())

  thread             ForumThread?             @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply              ForumReply?              @relation(fields: [replyId], references: [id], onDelete: Cascade)
  reporter           User                     @relation("ForumReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy         User?                    @relation("ForumReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionDecision ForumModerationDecision? @relation("ForumReportResolutionDecision", fields: [resolutionDecisionId], references: [id], onDelete: SetNull)

  @@unique([threadId, reporterId])
  @@unique([replyId, reporterId])
  @@index([status, createdAt])
}

model ForumAppeal {
  id                   String            @id @default(cuid())
  threadId             String?
  replyId              String?
  ownerId              String
  againstDecisionId    String?
  statement            String
  status               ForumAppealStatus @default(PENDING)
  idempotencyKey       String            @unique
  contentVersion       Int
  resolutionDecisionId String?
  resolvedById         String?
  resolvedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  thread             ForumThread?              @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply              ForumReply?               @relation(fields: [replyId], references: [id], onDelete: Cascade)
  owner              User                      @relation("ForumAppealOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  resolvedBy         User?                     @relation("ForumAppealResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  againstDecision    ForumModerationDecision?  @relation("ForumAppealAgainstDecision", fields: [againstDecisionId], references: [id], onDelete: SetNull)
  resolutionDecision ForumModerationDecision?  @relation("ForumAppealResolutionDecision", fields: [resolutionDecisionId], references: [id], onDelete: SetNull)
  outcomeDecisions   ForumModerationDecision[] @relation("ForumAppealOutcome")

  @@index([threadId])
  @@index([replyId])
}

model ForumVote {
  id       String  @id @default(cuid())
  userId   String
  threadId String?
  replyId  String?
  value    Int // 1 = upvote, -1 = downvote

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply  ForumReply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@unique([userId, replyId])
  @@index([threadId])
  @@index([replyId])
}

model Event {
  id          String      @id @default(cuid())
  userId      String
  barrioId    String
  title       String
  description String?
  date        DateTime
  location    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  barrio      Barrio      @relation(fields: [barrioId], references: [id], onDelete: Cascade)
  rsvps       EventRsvp[]

  @@index([barrioId, date])
}

model EventRsvp {
  id        String          @id @default(cuid())
  eventId   String
  userId    String
  status    EventRsvpStatus
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Message {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  postId     String?
  content    String
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  sender     User             @relation("messages_sent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User             @relation("messages_received", fields: [receiverId], references: [id], onDelete: Cascade)
  post       MarketplacePost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([senderId, receiverId, createdAt])
  @@index([postId, createdAt])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId, rating])
}

model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // "android" | "ios" | "web"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationOutbox {
  id              String    @id @default(cuid())
  userId          String
  title           String
  body            String
  data            Json
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5)
  nextAttemptAt   DateTime  @default(now())
  lockedAt        DateTime?
  lockToken       String?   @unique
  deliveredTokens String[]  @default([])
  processedAt     DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([processedAt, nextAttemptAt])
  @@index([userId, createdAt])
}
