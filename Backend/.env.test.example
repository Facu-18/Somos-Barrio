NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/somos-barrio-test?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=test_secret_that_is_at_least_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
SIGHTENGINE_ENABLED=false
MARKETPLACE_ASSET_CLEANUP_INTERVAL_MS=3600000
MARKETPLACE_ASSET_ORPHAN_TTL_MS=86400000
MARKETPLACE_REPORT_THRESHOLD=3
MARKETPLACE_REPORT_WINDOW_MS=3600000
MARKETPLACE_REPORT_USER_LIMIT=10
MARKETPLACE_APPEAL_USER_LIMIT=5
MARKETPLACE_ASSET_REVIEW_URL_TTL_SECONDS=300
MARKETPLACE_ASSET_REVIEW_TTL_MS=604800000
