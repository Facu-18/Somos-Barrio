# Local development may omit this to use the emulator/localhost fallback.
# Preview and production EAS environments must define an absolute API URL.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_EAS_PROJECT_ID=

# Android Firebase client values used to generate google-services.json only
# while Expo evaluates the app configuration.
FIREBASE_PROJECT_NUMBER=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_PACKAGE_NAME=com.somosbarrio.app
FIREBASE_ANDROID_API_KEY=
